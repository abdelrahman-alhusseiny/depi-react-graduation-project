@model ChooseRoleVM

@{
    ViewData["Title"] = "Choose Role";
}

<div class="container py-4">
    <h2 class="mb-4">
        <i class="bi bi-person-badge"></i> Register
    </h2>
    <p class="text-muted">Select your role to continue:</p>

    <div class="card shadow-sm p-4">
        <div class="row justify-content-center text-center">
            <div class="col-md-5 mb-4">
                <img src="@Model.CreatorImageUrl" alt="Creator"
                     class="img-fluid rounded shadow-sm" style="max-width:150px;" />
                <div class="mt-3">
                    <a asp-area="Identity" asp-controller="Account"
                       asp-action="RegisterCreator" class="btn btn-primary w-75">
                        <i class="bi bi-person"></i> Register as Creator
                    </a>
                </div>
            </div>

            <div class="col-md-5 mb-4">
                <img src="@Model.RespondentImageUrl" alt="Respondent"
                     class="img-fluid rounded shadow-sm" style="max-width:150px;" />
                <div class="mt-3">
                    <a asp-area="Identity" asp-controller="Account"
                       asp-action="RegisterRespondent" class="btn btn-success w-75">
                        <i class="bi bi-shop"></i> Register as Respondent
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
