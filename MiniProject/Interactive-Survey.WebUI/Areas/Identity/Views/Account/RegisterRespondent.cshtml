@model RegisterRespondentVM

@{
	ViewData["Title"] = "Register as Respondent";
}

<div class="container py-4">
	<h2 class="mb-4">
		<i class="bi bi-person-plus"></i> Register as Respondent
	</h2>

	<form asp-area="Identity" asp-controller="Account" asp-action="RegisterRespondent"
		  method="post" enctype="multipart/form-data" class="card shadow-sm p-4">
		@Html.AntiForgeryToken()

		<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

		<div class="mb-3">
			<label asp-for="Respondent.FullName" class="form-label">
				<i class="bi bi-person"></i> Full Name
			</label>
			<input asp-for="Respondent.FullName" class="form-control" />
			<span asp-validation-for="Respondent.FullName" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Email" class="form-label">
				<i class="bi bi-envelope"></i> Email
			</label>
			<input asp-for="Email" class="form-control" />
			<span asp-validation-for="Email" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Respondent.PhoneNumber" class="form-label">
				<i class="bi bi-telephone"></i> Phone Number
			</label>
			<input asp-for="Respondent.PhoneNumber" class="form-control" />
			<span asp-validation-for="Respondent.PhoneNumber" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Respondent.Address" class="form-label">
				<i class="bi bi-geo-alt"></i> Address
			</label>
			<input asp-for="Respondent.Address" class="form-control" />
			<span asp-validation-for="Respondent.Address" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Respondent.Gender" class="form-label">
				<i class="bi bi-gender-ambiguous"></i> Gender
			</label>
			<select asp-for="Respondent.Gender" asp-items="Model.GenderList" class="form-select">
				<option value="">-- Select Gender --</option>
			</select>
			<span asp-validation-for="Respondent.Gender" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Respondent.DateOfBirth" class="form-label">
				<i class="bi bi-calendar"></i> Date of Birth
			</label>
			<input asp-for="Respondent.DateOfBirth" type="date" class="form-control" />
			<span asp-validation-for="Respondent.DateOfBirth" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Respondent.ImageFile" class="form-label">
				<i class="bi bi-image"></i> Profile Image (Optional)
			</label>
			<input asp-for="Respondent.ImageFile" type="file" class="form-control"
				   accept="image/*" />
			<span asp-validation-for="Respondent.ImageFile" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="Password" class="form-label">
				<i class="bi bi-lock"></i> Password
			</label>
			<input asp-for="Password" class="form-control" />
			<span asp-validation-for="Password" class="text-danger"></span>
		</div>

		<div class="mb-3">
			<label asp-for="ConfirmPassword" class="form-label">
				<i class="bi bi-lock-fill"></i> Confirm Password
			</label>
			<input asp-for="ConfirmPassword" class="form-control" />
			<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
		</div>

		<div class="d-flex justify-content-between mt-4">
			<button type="submit" class="btn btn-success">
				<i class="bi bi-check-circle"></i> Register
			</button>
			<a asp-area="Identity" asp-controller="Account" asp-action="Login" class="btn btn-secondary">
				<i class="bi bi-arrow-left-circle"></i> Back to Login
			</a>
		</div>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
