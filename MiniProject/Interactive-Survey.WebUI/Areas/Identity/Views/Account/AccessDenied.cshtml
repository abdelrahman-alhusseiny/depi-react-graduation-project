@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5 text-center">
    <div class="card shadow-sm p-4">
        <div class="card-body">
            <h2 class="text-danger mb-3">
                <i class="bi bi-x-circle-fill"></i> Access Denied
            </h2>
            <p class="lead text-muted">
                You do not have permission to access this page.
            </p>

            <hr />

            <p class="text-secondary">
                Please make sure you are logged in with the correct account and role.
            </p>

            <a asp-area="Identity" asp-controller="Account" asp-action="Login"
               class="btn btn-primary mt-3">
                <i class="bi bi-box-arrow-in-right"></i> Go to Login
            </a>

            <a asp-area="Creator" asp-controller="Survey" asp-action="GetAllSurveys"
               class="btn btn-outline-secondary mt-3">
                <i class="bi bi-arrow-left-circle"></i> Back to Surveys
            </a>
        </div>
    </div>
</div>
