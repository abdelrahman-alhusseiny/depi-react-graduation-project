@model RespondentVM

@{
	ViewData["Title"] = "Delete Account";
}

<div class="container mt-4">
	<h2 class="mb-4 text-danger">
		<i class="bi bi-exclamation-triangle-fill"></i> Delete Account
	</h2>

	<div class="alert alert-danger text-center">
		<i class="bi bi-x-circle-fill"></i>
		<strong>Are you sure?</strong> Deleting your account is permanent and cannot be
		undone.
	</div>

	<div class="text-center mb-4">
		<img src="@Model.DisplayImageUrl" alt="Profile Image"
			 class="rounded-circle shadow-sm"
			 style="width:200px; height:200px; object-fit:cover;" />
	</div>

	<div class="row mb-4">
		<div class="col-md-8 offset-md-2">
			<dl class="row">
				<dt class="col-sm-4"><i class="bi bi-person"></i> Full Name</dt>
				<dd class="col-sm-8">@Model.Respondent.FullName</dd>

				<dt class="col-sm-4"><i class="bi bi-envelope"></i> Email</dt>
				<dd class="col-sm-8">@Model.AppUserEmail</dd>

				<dt class="col-sm-4"><i class="bi bi-telephone"></i> Phone Number</dt>
				<dd class="col-sm-8">@Model.Respondent.PhoneNumber</dd>

				<dt class="col-sm-4"><i class="bi bi-geo-alt"></i> Address</dt>
				<dd class="col-sm-8">@Model.Respondent.Address</dd>

				<dt class="col-sm-4"><i class="bi bi-gender-ambiguous"></i> Gender</dt>
				<dd class="col-sm-8">@Model.Respondent.Gender</dd>

				<dt class="col-sm-4"><i class="bi bi-calendar"></i> Date of Birth</dt>
				<dd class="col-sm-8">@Model.Respondent.DateOfBirth.ToString("yyyy-MM-dd")</dd>

				<dt class="col-sm-4">
					<i class="bi bi-clock-history"></i> Account Created On
				</dt>
				<dd class="col-sm-8">
					@Model.Respondent.CreatedAt.ToString("yyyy-MM-dd HH:mm")
				</dd>
			</dl>
		</div>
	</div>

	<form asp-area="Respondent" asp-controller="Profile" asp-action="DeleteAccount"
		  method="post" class="d-flex justify-content-end gap-2">
		@Html.AntiForgeryToken()
		<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

		<button type="submit" class="btn btn-danger">
			<i class="bi bi-trash-fill"></i> Confirm Delete
		</button>
		<a asp-area="Respondent" asp-controller="Profile" asp-action="GetProfile"
		   class="btn btn-secondary">
			<i class="bi bi-arrow-left-circle"></i> Cancel
		</a>
	</form>
</div>
