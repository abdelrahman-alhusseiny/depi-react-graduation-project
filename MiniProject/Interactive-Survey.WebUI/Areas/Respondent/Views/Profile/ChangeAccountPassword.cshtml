@model ChangePasswordVM

@{
    ViewData["Title"] = "Change Account Password";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-key"></i> Change Account Password</h2>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5><i class="bi bi-shield-lock"></i> Change Password for @Model.AppUserEmail</h5>
        </div>

        <div class="card-body">
            <form asp-area="Respondent" asp-controller="Profile" asp-action="ChangeAccountPassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input asp-for="AppUserEmail" type="hidden" />

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">
                        <i class="bi bi-lock-fill"></i> Current Password
                    </label>
                    <input asp-for="CurrentPassword" class="form-control" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">
                        <i class="bi bi-key-fill"></i> New Password
                    </label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">
                        <i class="bi bi-check2-circle"></i> Confirm New Password
                    </label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-success me-2">
                        <i class="bi bi-check-circle"></i> Change Password
                    </button>
                    <a asp-area="Respondent" asp-controller="Profile" asp-action="GetProfile"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
