@model SurveyVM

@{
    ViewData["Title"] = "Delete Survey";
}

<div class="container mt-4">
    <h2 class="mb-4 text-danger">
        <i class="bi bi-exclamation-triangle-fill"></i> Delete Survey
    </h2>

    <div class="alert alert-danger text-center">
        <i class="bi bi-x-circle-fill"></i>
        <strong>Are you sure?</strong> Deleting this survey is permanent and cannot be undone.
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3"><i class="bi bi-tags"></i> Name</dt>
                <dd class="col-sm-9">@Model.Survey.Title</dd>

                <dt class="col-sm-3"><i class="bi bi-card-text"></i> Description</dt>
                <dd class="col-sm-9">@Model.Survey.Description</dd>

                <dt class="col-sm-3"><i class="bi bi-clock-history"></i> Created On</dt>
                <dd class="col-sm-9">@Model.Survey.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>
        </div>
    </div>

    <form asp-area="Creator" asp-controller="Survey" asp-action="DeleteSurvey"
          method="post" class="d-flex justify-content-end gap-2">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input asp-for="Survey.SurveyId" type="hidden" />

        <input asp-for="SearchString" type="hidden" />
        <input asp-for="CurrentSort" type="hidden" />
        <input asp-for="CurrentPage" type="hidden" />

        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash-fill"></i> Confirm Delete
        </button>
        <a asp-area="Creator"
           asp-controller="Survey"
           asp-action="GetAllSurveys"
           asp-route-sourceView="@Model.SourceView"
           asp-route-id="@Model.Survey.SurveyId"
           asp-route-searchString="@Model.SearchString"
           asp-route-currentSort="@Model.CurrentSort"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Cancel
        </a>
    </form>
</div>
