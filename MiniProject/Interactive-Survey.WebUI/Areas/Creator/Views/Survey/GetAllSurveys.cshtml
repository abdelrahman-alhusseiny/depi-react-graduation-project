@model SurveyListVM

@{
    ViewData["Title"] = "Survey List";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>
            <i class="bi bi-people"></i> Survey List
        </h2>
        <a asp-area="Creator" asp-controller="Survey" asp-action="CreateSurvey"
           asp-route-searchString="@Model.SearchString"
           asp-route-currentSort="@Model.CurrentSort"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create Survey
        </a>
    </div>

    <!-- Search -->
    <form asp-area="Creator" asp-controller="Survey" asp-action="GetAllSurveys" method="get"
          class="row g-2 mb-3 align-items-center">
        <input type="hidden" name="currentSort" value="@Model.CurrentSort" />
        <input type="hidden" name="currentPage" value="1" />

        <div class="col-md-4">
            <input type="text"
                   name="searchString"
                   value="@Model.SearchString"
                   class="form-control search-bar"
                   placeholder="Search surveys..." />
        </div>

        <div class="col-md-2 d-flex">
            <a asp-area="Creator" asp-controller="Survey" asp-action="GetAllSurveys"
               class="btn btn-reset">
                <i class="bi bi-arrow-counterclockwise"></i> Reset
            </a>
        </div>
    </form>

    <!-- Sorting -->
    <div class="mb-3 sort-section">
        <span class="me-2 fw-bold">Sort by:</span>
        <a asp-area="Creator" asp-controller="Survey" asp-action="GetAllSurveys"
           asp-route-currentSort="@Model.TitleSort"
           asp-route-searchString="@Model.SearchString"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn sort-btn me-1">
            Title
            @if (Model.CurrentSort == "title")
            {
                <i class="bi bi-caret-up-fill"></i>
            }
            else if (Model.CurrentSort == "title_desc")
            {
                <i class="bi bi-caret-down-fill"></i>
            }
        </a>

        <a asp-area="Creator" asp-controller="Survey" asp-action="GetAllSurveys"
           asp-route-currentSort="@Model.CreatedAtSort"
           asp-route-searchString="@Model.SearchString"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn sort-btn">
            Created At
            @if (Model.CurrentSort == "created")
            {
                <i class="bi bi-caret-up-fill"></i>
            }
            else if (Model.CurrentSort == "created_desc")
            {
                <i class="bi bi-caret-down-fill"></i>
            }
        </a>
    </div>

    <!-- Surveys -->
    @if (!Model.Surveys.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> No surveys available.
        </div>
    }
    else
    {
        <div class="survey-container">
            @foreach (var item in Model.Surveys)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-tag"></i> @item.Survey.Title
                        </h5>
                        <p class="card-text">
                            <i class="bi bi-card-text"></i> @item.Survey.Description
                        </p>
                        <p class="created-date">
                            <i class="bi bi-clock-history"></i> Created At: @item.Survey.CreatedAt.ToString("yyyy-MM-dd")
                        </p>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <a asp-area="Creator" asp-controller="Question"
                               asp-action="GetAllQuestions" asp-route-surveyId="@item.Survey.SurveyId"
                               class="btn btn-sm btn-secondary">
                                <i class="bi bi-question-circle"></i> Questions
                            </a>

                            <a asp-area="Creator" asp-controller="Survey"
                               asp-action="GenerateLink" asp-route-surveyId="@item.Survey.SurveyId"
                               class="btn btn-sm btn-info">
                                <i class="bi bi-link-45deg"></i> Generate Link
                            </a>

                            <a asp-area="Creator" asp-controller="Survey"
                               asp-action="SurveyResults" asp-route-surveyId="@item.Survey.SurveyId"
                               class="btn btn-sm btn-success">
                                <i class="bi bi-bar-chart-line"></i> View Results
                            </a>

                            <a asp-area="Creator" asp-controller="Survey"
                               asp-action="EditSurvey" asp-route-id="@item.Survey.SurveyId"
                               class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>

                            <a asp-area="Creator" asp-controller="Survey"
                               asp-action="DeleteSurvey" asp-route-id="@item.Survey.SurveyId"
                               class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-between">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a asp-area="Creator" asp-controller="Survey" asp-action="GetAllSurveys"
                           asp-route-currentPage="@(Model.CurrentPage - 1)"
                           asp-route-searchString="@Model.SearchString"
                           asp-route-currentSort="@Model.CurrentSort"
                           class="page-link">Previous</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link">Previous</span></li>
                }

                <li class="page-item flex-grow-1 d-flex justify-content-center">
                    <ul class="pagination mb-0">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a asp-area="Creator" asp-controller="Survey"
                                   asp-action="GetAllSurveys"
                                   asp-route-currentPage="@i"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-currentSort="@Model.CurrentSort"
                                   class="page-link">@i</a>
                            </li>
                        }
                    </ul>
                </li>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a asp-area="Creator" asp-controller="Survey" asp-action="GetAllSurveys"
                           asp-route-currentPage="@(Model.CurrentPage + 1)"
                           asp-route-searchString="@Model.SearchString"
                           asp-route-currentSort="@Model.CurrentSort"
                           class="page-link">Next</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link">Next</span></li>
                }
            </ul>
        </nav>
    }
</div>
