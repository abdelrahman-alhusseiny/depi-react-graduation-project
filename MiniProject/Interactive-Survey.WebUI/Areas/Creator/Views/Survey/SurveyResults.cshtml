@model SurveyResultsVM

@{
    ViewData["Title"] = "Survey Results";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary">
        <i class="bi bi-bar-chart-line"></i> Results for: @Model.Survey.Title
    </h2>
    <p class="text-muted">@Model.Survey.Description</p>

    @foreach (var q in Model.QuestionsResults)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <strong>@q.Question.QuestionText</strong>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Option</th>
                            <th>Responses</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var opt in q.OptionsResults)
                        {
                            <tr>
                                <td>@opt.Option.OptionText</td>
                                <td>@opt.AnswersCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-area="Creator" asp-controller="Survey" asp-action="GetAllSurveys"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left-circle"></i> Back to Surveys
        </a>
    </div>
</div>
