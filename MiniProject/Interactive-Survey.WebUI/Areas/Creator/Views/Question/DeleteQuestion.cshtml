@model QuestionVM

@{
    ViewData["Title"] = "Delete Question";
}

<div class="container mt-4">
    <h2 class="mb-4 text-danger">
        <i class="bi bi-trash"></i> Delete Question
    </h2>

    <div class="alert alert-warning">
        <strong>Are you sure you want to delete this question?</strong><br />
        This action cannot be undone.
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <span class="fw-bold text-primary">@Model.Question.QuestionText</span>
        </div>
        <div class="card-body">
            <h6 class="text-muted">Options:</h6>
            <ul class="list-group list-group-flush mb-3">
                @foreach (var opt in Model.Options)
                {
                    <li class="list-group-item">
                        <i class="bi bi-dot"></i> @opt.OptionText
                    </li>
                }
            </ul>
        </div>
    </div>

    <form asp-action="DeleteQuestion" asp-controller="Question" asp-area="Creator" method="post">
        <input type="hidden" asp-for="SurveyId" />
        <input type="hidden" asp-for="Question.QuestionId" />

        <div class="mt-4">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Confirm Delete
            </button>
            <a asp-action="GetAllQuestions" asp-route-surveyId="@Model.SurveyId" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Cancel
            </a>
        </div>
    </form>
</div>
