@model QuestionVM

@{
    ViewData["Title"] = "Create Question";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary">
        <i class="bi bi-plus-circle"></i> Add New Question
    </h2>

    <form asp-action="CreateQuestion" asp-controller="Question" asp-area="Creator" method="post" class="needs-validation">
        <input type="hidden" asp-for="SurveyId" />

        <div class="mb-3">
            <label asp-for="Question.QuestionText" class="form-label">Question Text</label>
            <input asp-for="Question.QuestionText" class="form-control" placeholder="Enter your question..." required />
            <span asp-validation-for="Question.QuestionText" class="text-danger"></span>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Options (4 only)</label>
            <div id="options-container">
                <div class="input-group mb-2">
                    <input name="Options[0].OptionText" class="form-control" placeholder="Option 1" required />
                </div>
                <div class="input-group mb-2">
                    <input name="Options[1].OptionText" class="form-control" placeholder="Option 2" required />
                </div>
                <div class="input-group mb-2">
                    <input name="Options[2].OptionText" class="form-control" placeholder="Option 3" required />
                </div>
                <div class="input-group mb-2">
                    <input name="Options[3].OptionText" class="form-control" placeholder="Option 4" required />
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-circle"></i> Save Question
            </button>
            <a asp-action="GetAllQuestions" asp-route-surveyId="@Model.SurveyId" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Questions
            </a>
        </div>
    </form>
</div>
