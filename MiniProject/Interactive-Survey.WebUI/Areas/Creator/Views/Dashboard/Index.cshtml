<div class="container mt-4">
	<!-- Welcome Section -->
	<div class="mb-4 text-center">
		<h2 class="fw-bold">Dashboard</h2>
		<p class="text-muted">Manage your surveys, questions, and results in one place.</p>
	</div>

	<!-- Quick Actions -->
	<div class="row mb-4">
		<div class="col-md-3">
			<a asp-area="Creator" asp-controller="Profile" asp-action="GetProfile"
			   class="card text-center shadow-sm p-3">
				<i class="bi bi-person-circle fs-2 text-danger"></i>
				<h5 class="mt-2">Profile</h5>
				<p class="text-muted">Update account info</p>
			</a>
		</div>
		<div class="col-md-3">
			<a asp-area="Creator" asp-controller="Survey" asp-action="GetAllSurveys"
			   class="card text-center shadow-sm p-3">
				<i class="bi bi-list-task fs-2 text-primary"></i>
				<h5 class="mt-2">Surveys</h5>
				<p class="text-muted">View & create surveys</p>
			</a>
		</div>
	</div>
</div>
