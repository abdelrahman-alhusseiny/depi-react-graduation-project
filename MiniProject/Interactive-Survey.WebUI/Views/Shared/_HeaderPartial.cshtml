<header>
	<nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
		<div class="container-fluid">
			<a class="navbar-brand" asp-area="" asp-controller="Home"
			   asp-action="Index">
				Interactive Survey
			</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse"
					data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
					aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>

			<div class="navbar-collapse collapse d-sm-inline-flex
			   justify-content-between">

				<ul class="navbar-nav flex-grow-1">
					@if (!User.Identity.IsAuthenticated)
					{
						<li class="nav-item">
							<a class="nav-link text-dark" asp-area="" asp-controller="Home"
							   asp-action="Index">
								<i class="bi bi-house"></i> Home
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-dark" asp-area="" asp-controller="Home"
							   asp-action="Privacy">
								<i class="bi bi-shield"></i> Privacy
							</a>
						</li>
					}

					@if (User.IsInRole(SD.Role_Creator))
					{
						<li class="nav-item">
							<a class="nav-link text-dark" asp-area="Creator"
							   asp-controller="Dashboard" asp-action="Index">
								<i class="bi bi-speedometer2"></i> Dashboard
							</a>
						</li>

						<li class="nav-item">
							<a class="nav-link text-dark" asp-area="Creator"
							   asp-controller="Profile" asp-action="GetProfile">
								<i class="bi bi-person-circle"></i> Profile
							</a>
						</li>

						<li class="nav-item">
							<a class="nav-link text-dark" asp-area="Creator"
							   asp-controller="Survey" asp-action="GetAllSurveys">
								<i class="bi bi-list-task"></i> Surveys
							</a>
						</li>
					}


					@if (User.IsInRole(SD.Role_Respondent))
					{
						<li class="nav-item">
							<a class="nav-link text-dark" asp-area="Respondent"
							   asp-controller="Dashboard" asp-action="Index">
								<i class="bi bi-speedometer2"></i> Dashboard
							</a>
						</li>

						<li class="nav-item">
							<a class="nav-link text-dark" asp-area="Respondent"
							   asp-controller="Profile" asp-action="GetProfile">
								<i class="bi bi-shop"></i> Profile
							</a>
						</li>
					}
				</ul>

				<ul class="navbar-nav ms-auto align-items-center">
					@if (!User.Identity.IsAuthenticated)
					{
						<li class="nav-item">
							<a class="nav-link text-dark" asp-area="Identity"
							   asp-controller="Account" asp-action="ChooseRole">
								<i class="bi bi-person-plus"></i> Register
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-dark" asp-area="Identity"
							   asp-controller="Account" asp-action="Login">
								<i class="bi bi-box-arrow-in-right"></i> Login
							</a>
						</li>
					}


					@if (User.Identity.IsAuthenticated)
					{
						<li class="nav-item">
							<form asp-area="Identity" asp-controller="Account"
								  asp-action="Logout" method="post" class="d-inline">
								@Html.AntiForgeryToken()
								<button type="submit" class="nav-link btn btn-link
									   text-dark p-0">
									<i class="bi bi-box-arrow-right"></i> Logout
								</button>
							</form>
						</li>
					}
				</ul>
			</div>
		</div>
	</nav>
</header>
