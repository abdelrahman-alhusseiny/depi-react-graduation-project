@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5 text-center">
    <!-- Welcome Section -->
    <h1 class="display-4 fw-bold mb-3">Welcome to Interactive Survey</h1>
    <p class="lead text-muted mb-4">
        Create, manage, and analyze surveys with ease.
        Join us today and start engaging with your audience.
    </p>

    <!-- Call to Action -->
    <div class="d-flex justify-content-center gap-3 mb-5">
        <a asp-area="Identity" asp-controller="Account" asp-action="ChooseRole"
           class="btn btn-primary btn-lg">
            <i class="bi bi-person-plus"></i> Register
        </a>
        <a asp-area="Identity" asp-controller="Account" asp-action="Login"
           class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-box-arrow-in-right"></i> Login
        </a>
    </div>

    <!-- Features Section -->
    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-list-task fs-1 text-primary"></i>
                    <h5 class="card-title mt-3">Create Surveys</h5>
                    <p class="card-text text-muted">
                        Build custom surveys tailored to your needs with powerful tools.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-bar-chart-line fs-1 text-success"></i>
                    <h5 class="card-title mt-3">Analyze Results</h5>
                    <p class="card-text text-muted">
                        Gain insights with detailed analytics and visual reports.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-people fs-1 text-warning"></i>
                    <h5 class="card-title mt-3">Engage Respondents</h5>
                    <p class="card-text text-muted">
                        Connect with participants and collect valuable feedback easily.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
